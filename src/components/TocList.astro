---
import type { TocNode } from '../lib/toc';

interface Props {
  nodes: TocNode[];
}

const { nodes } = Astro.props;
---

<ol>
  {
    nodes.map((node) => (
      <li>
        {node.children.length > 0 ? (
          <details data-toc-slug={node.heading.slug}>
            <summary>
              <a class="link" href={`#${node.heading.slug}`}>
                {node.heading.html ? (
                  <span set:html={node.heading.html} />
                ) : (
                  node.heading.text
                )}
              </a>
            </summary>
            <Astro.self nodes={node.children} />
          </details>
        ) : (
          <a class="link" href={`#${node.heading.slug}`}>
            {node.heading.html ? <span set:html={node.heading.html} /> : node.heading.text}
          </a>
        )}
      </li>
    ))
  }
</ol>
