---
import { formatDate } from '../lib/notes';

interface Props {
  title: string;
  pubDate?: Date;
  description?: string;
}

const { title, pubDate, description } = Astro.props;
const iso = pubDate?.toISOString().slice(0, 10);
---

<header>
  <h1>{title}</h1>
  {
    pubDate && (
      <time datetime={iso}>{formatDate(pubDate)}</time>
    )
  }
  {description && <p>{description}</p>}
</header>
