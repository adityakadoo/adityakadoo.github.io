---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { publishedNotes } from '../lib/notes';
import { site } from '../site';

const courses = publishedNotes(await getCollection('courses'));
---

<BaseLayout title={site.title} description={site.description} isHome showFooter={false}>
  <main id="main">
    <article class="content">
      <SiteHeader title={site.title} description={site.description} />
      <div class="tableofcontent">
        <h2>Contents</h2>
        <ol>
          <li>
            <b><a class="link" href="/courses/">Courses</a></b>
            <ol>
              {
                courses.map((entry) => (
                  <li>
                    <a class="link" href={`/courses/${entry.id}/`}>
                      {entry.data.title}
                    </a>
                  </li>
                ))
              }
            </ol>
          </li>
        </ol>
      </div>
    </article>
  </main>
</BaseLayout>
