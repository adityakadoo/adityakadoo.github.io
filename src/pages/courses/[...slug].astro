---
import { getCollection, getEntry, render } from 'astro:content';
import ArticlePlayer from '../../components/ArticlePlayer.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import { loadPlayerPayload } from '../../lib/content-ir/player';
import { neighbors } from '../../lib/notes';
import { site } from '../../site';
import { withMathLabels } from '../../lib/toc-labels';

export async function getStaticPaths() {
  const entries = await getCollection('courses', ({ id, data }) => id !== '_index' && !data.draft);
  return entries.map((entry) => ({
    params: { slug: entry.id },
  }));
}

const slugParam = Astro.params.slug;
const slug = Array.isArray(slugParam) ? slugParam.join('/') : slugParam;
const entry = await getEntry('courses', slug!);
if (!entry) throw new Error(`Unknown course: ${slug}`);

const { Content, headings } = await render(entry);
const allEntries = await getCollection('courses');
const { prev, next } = neighbors(allEntries, entry.id);
const player = loadPlayerPayload('courses', entry.id);
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  pubDate={entry.data.date}
  showFooter={entry.data.footer}
  math={entry.data.math}
  headings={entry.data.toc ? withMathLabels('courses', entry.id, headings) : []}
>
  <main id="main">
    <article class="content">
      <SiteHeader
        title={entry.data.title}
        pubDate={entry.data.date}
        description={entry.data.description}
      />
      <Content />
    </article>
    <nav class="paginator">
      {prev ? <a class="link" href={`/courses/${prev.id}/`}>← prev</a> : <span />}
      {next ? <a class="link" href={`/courses/${next.id}/`}>next →</a> : <span />}
    </nav>
  </main>
  <div slot="player">
    {player && <ArticlePlayer payload={player} title={entry.data.title} artist={site.author} />}
  </div>
</BaseLayout>
